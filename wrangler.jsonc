{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "github-profile-counter",
	"main": "src/index.ts",
	"compatibility_date": "2025-11-27",
	"kv_namespaces": [
		{
			"binding": "PROFILE_VIEWS",
			"id": "a9a3b3d03f044f059c4476d1bdcff61f"
		}
	],
	"observability": {
		"logs": {
		"enabled": true,
		"head_sampling_rate": 1,
		"invocation_logs": true,
		"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"metrics": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	}
